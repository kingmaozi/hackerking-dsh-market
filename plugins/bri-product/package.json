{
  "name": "bri-product",
  "version": "0.2.0",
  "description": "brking.ai 产品库 DSH 插件：13 个 product_* MCP 工具（搜索/取图/对比/图片审计/做图上下文/按需缓存）+ product-library 技能；本地只存元数据与图床 URL。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "mcp",
    "skills",
    "scripts/selftest.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "bin": {
    "bri-products": "bin/query.mjs",
    "bri-products-sync": "bin/sync.mjs",
    "bri-products-compare": "bin/compare.mjs",
    "bri-products-audit": "bin/audit-images.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "mcp": "node mcp/server.mjs",
    "sync": "node bin/sync.mjs",
    "sync:force": "node bin/sync.mjs --force",
    "query": "node bin/query.mjs",
    "compare": "node bin/compare.mjs",
    "audit": "node bin/audit-images.mjs",
    "audit:remote": "node bin/audit-images.mjs --remote",
    "security": "node bin/security-audit.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "product",
    "catalog",
    "ecommerce",
    "image",
    "mcp",
    "brking"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingmaozi/hackerking-dsh-market.git",
    "directory": "plugins/bri-product"
  },
  "homepage": "https://github.com/kingmaozi/hackerking-dsh-market/tree/main/plugins/bri-product"
}
