    "directory": "plugins/imgen"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "homepage": "https://github.com/kingmaozi/hackerking-dsh-market/tree/main/plugins/imgen"
