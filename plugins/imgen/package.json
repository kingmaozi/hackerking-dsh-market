    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "mcp",
    "dist",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "bundledDependencies": [
    "@ossiana/node-libcurl",
    "node-libcurl",
    "node-libcurl-darwin-arm64",
    "commander",
    "node-addon-api"
  ],
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@ossiana/node-libcurl": "^1.10.7",
    "commander": "^12.0.0"
