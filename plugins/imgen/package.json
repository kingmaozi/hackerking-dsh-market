  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image-generation",
    "imgen",
    "codex",
    "chatgpt",
    "oauth",
    "mcp",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
